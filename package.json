{
  "name": "xiaomaoqiu-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "desktop": "electron .",
    "build:agent-manager": "node scripts/build-agent-manager.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "local": "node scripts/local.ts",
    "check": "tsc --noEmit",
    "start": "node server/index.ts",
    "connector": "node connector/index.ts",
    "backup": "node scripts/backup.ts",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.15",
    "markdown-it": "15.0.3",
    "robots-parser": "3.1.1",
    "ws": "^8.18.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "electron": "45.4.1",
    "typescript": "5.9"
  }
