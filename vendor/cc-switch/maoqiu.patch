new file mode 100644
index 0000000000000000000000000000000000000000..9b96a781f53e6bc2334e17318e05a43b1ea8077b
--- /dev/null
+++ b/src-tauri/src/maoqiu_host.rs
@@ -0,0 +1,187 @@
+use std::{
+    io::{self, BufRead},
+    path::Path,
+};
+use rusqlite::{Connection, OpenFlags};
+use serde::Serialize;
+use tauri::{AppHandle, Manager, State};
+
+use crate::{database::Database, error::AppError, store::AppState};
+
+/// The Electron owner holds this pipe open until it exits.
+pub(crate) fn listen_for_owner(app: AppHandle) {
+    std::thread::spawn(move || {
+        for line in io::stdin().lock().lines() {
+            match line.as_deref() {
+                Ok("show") => {
+                    if let Some(window) = app.get_webview_window("main") {
+                        let _ = window.unminimize();
+                        let _ = window.show();
+                        let _ = window.set_focus();
+                    }
+                }
+                Ok("quit") | Err(_) => break,
+                _ => {}
+            }
+        }
+        app.exit(0);
+    });
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct CatalogImport {
+    providers: usize,
+    mcp_servers: usize,
+    prompts: usize,
+    skill_repos: usize,
+}
+
+const PROVIDER_COLUMNS: &[&str] = &[
+    "id", "app_type", "name", "settings_config", "website_url", "category",
+    "created_at", "sort_index", "notes", "icon", "icon_color", "meta",
+];
+const MCP_COLUMNS: &[&str] = &[
+    "id", "name", "server_config", "description", "homepage", "docs", "tags",
+];
+const PROMPT_COLUMNS: &[&str] = &[
+    "id", "app_type", "name", "content", "description", "created_at", "updated_at", "enabled",
+];
+const SKILL_REPO_COLUMNS: &[&str] = &["owner", "name", "branch", "host", "enabled"];
+
+fn merge_rows(
+    source: &Connection,
+    destination: &Connection,
+    table: &str,
+    columns: &[&str],
+    select: &str,
+    conflict: &str,
+) -> Result<usize, AppError> {
+    let mut source_rows = source.prepare(&format!("SELECT {select} FROM {table} LIMIT 10001"))?;
+    let mut read = source_rows.query([])?;
+    let parameters = vec!["?"; columns.len()].join(",");
+    let mut write = destination.prepare(&format!(
+        "INSERT INTO {table} ({}) VALUES ({parameters}) ON CONFLICT ({conflict}) DO NOTHING",
+        columns.join(",")
+    ))?;
+    let mut copied = 0;
+    let mut rows_seen = 0;
+    while let Some(row) = read.next()? {
+        rows_seen += 1;
+        if rows_seen > 10_000 {
+            return Err(AppError::Message("导入配置记录过多".into()));
+        }
+        let values = (0..columns.len())
+            .map(|index| row.get::<_, rusqlite::types::Value>(index))
+            .collect::<Result<Vec<_>, _>>()?;
+        copied += write.execute(rusqlite::params_from_iter(values))?;
+    }
+    Ok(copied)
+}
+
+fn merge_catalog(
+    source: &Connection,
+    destination: &mut Connection,
+    apply: bool,
+) -> Result<CatalogImport, AppError> {
+    let transaction = destination.transaction()?;
+    let providers = merge_rows(
+        source, &transaction, "providers", PROVIDER_COLUMNS,
+        "id, app_type, name, settings_config, website_url, category, created_at, sort_index, notes,
+         icon, icon_color, CASE WHEN json_valid(meta) THEN json_remove(meta, '$.liveConfigManaged') ELSE '{}' END",
+        "id, app_type",
+    )?;
+    let mcp_servers = merge_rows(
+        source, &transaction, "mcp_servers", MCP_COLUMNS, &MCP_COLUMNS.join(","), "id",
+    )?;
+    let prompts = merge_rows(
+        source, &transaction, "prompts", PROMPT_COLUMNS,
+        "id, app_type, name, content, description, created_at, updated_at, 0", "id, app_type",
+    )?;
+    let skill_repos = merge_rows(
+        source, &transaction, "skill_repos", SKILL_REPO_COLUMNS,
+        "owner, name, branch, host, 0", "owner, name",
+    )?;
+    if apply {
+        transaction.commit()?;
+    } else {
+        transaction.rollback()?;
+    }
+    Ok(CatalogImport { providers, mcp_servers, prompts, skill_repos })
+}
+
+pub(crate) fn legacy_catalog(
+    source: &Path,
+    destination: &Database,
+    apply: bool,
+) -> Result<CatalogImport, AppError> {
+    if !source.is_file() {
+        return Err(AppError::Message("请选择 CC Switch 的配置数据库或 SQL 导出文件".into()));
+    }
+    let conn = if source.extension().is_some_and(|suffix| suffix.eq_ignore_ascii_case("sql")) {
+        let staging = Database::memory()?;
+        // Reuse the upstream SQL validator, authorizer and time/size limits.
+        staging.import_sql(source)?;
+        staging.snapshot_to_memory()?
+    } else {
+        Connection::open_with_flags(source, OpenFlags::SQLITE_OPEN_READ_ONLY)?
+    };
+    conn.execute_batch("PRAGMA query_only = ON; PRAGMA trusted_schema = OFF;")?;
+    let mut destination = destination.conn.lock().map_err(|_| {
+        AppError::Database("无法打开管理设置数据库".into())
+    })?;
+    merge_catalog(&conn, &mut destination, apply)
+}
+
+#[tauri::command]
+pub(crate) async fn preview_legacy_config(
+    file_path: String,
+    state: State<'_, AppState>,
+) -> Result<CatalogImport, String> {
+    let db = state.db.clone();
+    tauri::async_runtime::spawn_blocking(move || legacy_catalog(Path::new(&file_path), &db, false))
+        .await
+        .map_err(|error| error.to_string())?
+        .map_err(|error| error.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preview_and_merge_preserve_local_and_do_not_enable_imported_items() {
+        let source = Database::memory().unwrap();
+        let destination = Database::memory().unwrap();
+        let source = source.conn.lock().unwrap();
+        let mut destination = destination.conn.lock().unwrap();
+        source.execute_batch(
+            "INSERT INTO providers (id, app_type, name, settings_config, is_current, meta)
+             VALUES ('legacy', 'dsh', 'Imported', '{}', 1, '{\"liveConfigManaged\":true}'),
+                    ('same', 'dsh', 'Old', '{}', 1, '{}');
+             INSERT INTO prompts (id, app_type, name, content, enabled)
+             VALUES ('prompt', 'dsh', 'Imported prompt', 'text', 1);
+             INSERT INTO mcp_servers (id, name, server_config, enabled_dsh)
+             VALUES ('mcp', 'Imported MCP', '{}', 1);",
+        ).unwrap();
+        destination.execute_batch(
+            "INSERT INTO providers (id, app_type, name, settings_config)
+             VALUES ('same', 'dsh', 'Local', '{}');",
+        ).unwrap();
+        assert_eq!(merge_catalog(&source, &mut destination, false).unwrap().providers, 1);
+        let count: i64 = destination.query_row(
+            "SELECT COUNT(*) FROM providers WHERE id = 'legacy'", [], |row| row.get(0)
+        ).unwrap();
+        assert_eq!(count, 0);
+        assert_eq!(merge_catalog(&source, &mut destination, true).unwrap().providers, 1);
+        assert_eq!(merge_catalog(&source, &mut destination, true).unwrap().providers, 0);
+        let options: (String, bool, bool, bool) = destination.query_row(
+            "SELECT (SELECT name FROM providers WHERE id = 'same'),
+                    (SELECT is_current FROM providers WHERE id = 'legacy'),
+                    (SELECT enabled FROM prompts WHERE id = 'prompt'),
+                    (SELECT enabled_dsh FROM mcp_servers WHERE id = 'mcp')",
+            [], |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?))
+        ).unwrap();
+        assert_eq!(options, ("Local".into(), false, false, false));
+    }
+}
