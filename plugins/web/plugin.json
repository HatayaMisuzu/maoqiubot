{
  "id": "web",
  "name": "网页搜索与读取",
  "version": "1.0.0",
  "hostApi": 1,
  "description": "搜索公开网页，读取静态正文并保留来源。",
  "entry": "index.ts",
  "skills": ["skills/web-research"],
  "capabilities": ["tools", "skills", "network.public", "network.api"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "provider": {"enum": ["brave", "searxng"]},
      "endpoint": {"type": "string", "maxLength": 1800},
      "keyEnv": {"type": "string", "pattern": "^MAOQIU_PLUGIN_KEY_[A-Z0-9_]{1,80}$"},
      "privateLan": {"type": "boolean"},
      "language": {"type": "string", "maxLength": 20},
      "region": {"type": "string", "maxLength": 8},
      "timeoutMs": {"type": "integer", "minimum": 500, "maximum": 20000},
      "maxResults": {"type": "integer", "minimum": 1, "maximum": 20}
    }
  }
}
